# ---- PyInstaller / build output (regenerated by Build-EXE.bat) ----
# NOTE: git does NOT support inline "# comment" on a pattern line - the whole
# line becomes the pattern and matches nothing. Keep comments on their OWN line.
build/
dist/
# extracted Tcl/Tk data; recreated by extract_tcl.py
build_res/
# GAMGUI.spec is regenerated each build
*.spec

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Runtime / local ----
# per-session logs written at runtime
Logs/
# local machine's saved gam.exe path
gamgui.ini

# ---- Packaging / staging artifacts ----
GAMGUI-Distribution/
GAMGUI-Source/
_share_stage/
*.zip
